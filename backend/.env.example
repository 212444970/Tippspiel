PORT=3001

# Firebase Admin SDK — download from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# API-Football — https://www.api-football.com/
# Free tier: 100 requests/day
API_FOOTBALL_KEY=your-api-football-key

# World Cup 2026 league ID on API-Football is 1 (FIFA World Cup)
API_FOOTBALL_WC_LEAGUE=1
API_FOOTBALL_WC_SEASON=2026

# Frontend URL for CORS (e.g. https://your-app.web.app or http://localhost:5173)
FRONTEND_URL=http://localhost:5173
