PORT=3001

# Firebase Admin SDK — download from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# football-data.org — https://www.football-data.org/
# Free tier includes World Cup and major leagues
FOOTBALL_DATA_KEY=your-football-data-api-key

# Competition code: WC = FIFA World Cup, PL = Premier League, CL = Champions League
FOOTBALL_DATA_COMPETITION=WC

# Frontend URL for CORS (e.g. https://your-app.web.app or http://localhost:5173)
FRONTEND_URL=http://localhost:5173
